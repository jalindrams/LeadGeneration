# ======================
# Micraft Growth Engine
# ======================

# Database — MS SQL (local SQL Server Express, Windows auth)
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/MicraftLeads?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# Old Postgres, read-only, used only by scripts/migrate_pg_to_mssql.py
PG_SOURCE_URL=
# Shared Places free-tier counter file (keep one file across checkouts)
PLACES_USAGE_FILE=
DATABASE_URL=postgresql://micraft:micraft_pass@localhost:5432/micraft_leads

# Google Maps Places API — FREE TIER ONLY, never paid.
# App-wide hard cap on Places calls per month (guard: app/utils/places_budget.py).
# 4000 sits under Google's smallest per-SKU free tier (5000/month).
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
PLACES_MONTHLY_CALL_CAP=4000

# Scraper Settings
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=8
SCRAPE_MAX_PAGES=5

# Target Cities (comma-separated)
TARGET_CITIES=Pune,Mumbai,Chennai,Ahmedabad

# Target Industries (comma-separated search terms for IndiaMART)
TARGET_SEARCHES=Automotive Manufacturer, Pharmaceutical Manufacturer, Electronics Manufacturer, Food Beverage Manufacturer, Aerospace Manufacturer

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CSV Export Path
CSV_EXPORT_DIR=./exports

# ======================
# Phase 3: Revenue Engine
# ======================

# Score >= this fires instant hot-lead alerts
HOT_LEAD_THRESHOLD=70

# WhatsApp alerts via Twilio (leave blank to disable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+919800000000

# Slack incoming webhook (leave blank to disable)
SLACK_WEBHOOK_URL=

# Email alerts via SMTP (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# HubSpot Private App token (leave blank to disable CRM sync)
HUBSPOT_API_KEY=

# ======================
# Action 2: Outreach Engine
# ======================

# WhatsApp Business Cloud API (Meta) — free tier: 1,000 conversations/month
# Setup: business.facebook.com → Add WhatsApp number → Get System User token
# Submit templates in: WhatsApp Manager → Message Templates
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Outreach sender identity
OUTREACH_FROM_NAME=Micraft Solutions
OUTREACH_FROM_EMAIL=sales@micraft.co.in

# Cadence controls
OUTREACH_DAILY_LIMIT=50
OUTREACH_COOLDOWN_DAYS=3


# =====================================================================
# Shiplystic store pipeline
# =====================================================================
ECOM_DAILY_TARGET=50
ECOM_WORKERS=8
# Alerts (short batch, failing sources). Off by default: log file only.
PIPELINE_ALERTS_ENABLED=false

# --- Paid sources (Phase 3). ALL OFF until a key AND a cap are set. ---
# Hard monthly caps in INR, checked before every paid call (app/pipeline/paid/ledger.py)
PAID_TOTAL_CAP_INR=0
PAID_SERPER_CAP_INR=0
PAID_STORELEADS_CAP_INR=0
PAID_EASYLEADZ_CAP_INR=0
PAID_GOOGLE_PLACES_CAP_INR=0     # Places calls beyond the free 4000/month cap
SERPER_API_KEY=
SERPER_COST_PER_QUERY_INR=0.09
STORELEADS_API_KEY=
STORELEADS_SUBSCRIPTION_INR=0    # recorded once per month in the ledger
STORELEADS_COMPETITOR_APPS=      # e.g. shopify.<token>,shopify.<token> from Store Leads' app list
PLACES_PAID_COST_INR=2.8
